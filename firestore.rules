rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for 5-role RBAC & Data Isolation
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return isRole('superAdmin');
    }

    function isFarmOwner() {
      return isRole('farmOwner');
    }

    function isTechnician() {
      return isRole('technician');
    }

    function isFarmWorker() {
      return isRole('farmWorker');
    }

    function isFinanceManager() {
      return isRole('financeManager');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || isOwner(userId);
      allow update, delete: if isSuperAdmin() || isOwner(userId);
    }

    // 2. Farms Collection
    match /farms/{farmId} {
      allow read: if isSuperAdmin() || 
                    (isFarmOwner() && resource.data.ownerUserId == request.auth.uid) ||
                    isTechnician() || isFarmWorker();
      allow write: if isSuperAdmin() || 
                     (isFarmOwner() && (request.resource.data.ownerUserId == request.auth.uid || resource.data.ownerUserId == request.auth.uid));
    }

    // 3. Devices Collection
    match /devices/{deviceId} {
      allow read: if isSuperAdmin() || 
                    (isFarmOwner() && resource.data.ownerUserId == request.auth.uid) ||
                    isTechnician() || isFarmWorker();
      allow write: if isSuperAdmin() || isTechnician() ||
                     (isFarmOwner() && resource.data.ownerUserId == request.auth.uid);
    }

    // 4. Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow write: if isSuperAdmin();
    }

    // 5. Irrigation Schedules & Logs
    match /irrigationSchedules/{scheduleId} {
      allow read: if isSuperAdmin() || 
                    (isFarmOwner() && resource.data.ownerUserId == request.auth.uid) ||
                    isFarmWorker();
      allow write: if isSuperAdmin() || 
                     (isFarmOwner() && resource.data.ownerUserId == request.auth.uid) ||
                     isFarmWorker();
    }

    match /irrigationLogs/{logId} {
      allow read: if isSuperAdmin() || 
                    (isFarmOwner() && resource.data.ownerUserId == request.auth.uid) ||
                    isFarmWorker();
      allow write: if isSignedIn();
    }

    // 6. Quotations, Invoices & Subscriptions
    match /quotations/{quotationId} {
      allow read: if isSuperAdmin() || isFinanceManager() || 
                    (isFarmOwner() && resource.data.ownerUserId == request.auth.uid);
      allow write: if isSuperAdmin() || isFinanceManager();
    }

    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isFinanceManager() || 
                    (isFarmOwner() && resource.data.ownerUserId == request.auth.uid);
      allow write: if isSuperAdmin() || isFinanceManager();
    }

    // 7. Inspections Collection
    match /inspections/{inspectionId} {
      allow read: if isSuperAdmin() || 
                    isTechnician() || 
                    (isFarmOwner() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isSuperAdmin() || isFarmOwner();
      allow update: if isSuperAdmin() || isTechnician();
      allow delete: if isSuperAdmin();
    }
  }
}
