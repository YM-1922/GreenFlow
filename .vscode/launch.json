{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌿 Green Flow (Flutter + Python Bridge)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": ["-d", "chrome"],
      "preLaunchTask": "Start Green Flow ESP32 Simulator",
      "presentation": {
        "group": "greenflow",
        "order": 1
      }
    },
    {
      "name": "Flutter Web only (no Python)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": ["-d", "chrome"]
    },
    {
      "name": "Python ESP32 Simulator only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/hardware_simulation/virtual_esp32.py",
      "console": "integratedTerminal",
      "python": "C:\\Users\\Joo\\AppData\\Local\\Python\\bin\\python.exe"
    }
  ]
}
